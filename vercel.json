{
  "functions": {
    "api/chat.js": {
      "includeFiles": "public/data/**",
      "maxDuration": 30
    },
    "api/data.js": {
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/corpus/:asset",
      "destination": "https://github.com/champchitsa/ngob-gae/releases/download/corpus-v1/:asset"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
